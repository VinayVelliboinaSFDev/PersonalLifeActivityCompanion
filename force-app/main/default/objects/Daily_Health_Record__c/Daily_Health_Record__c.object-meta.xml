<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Stores daily health and well-being activity records for a Contact, including food intake, physical activity, health metrics, mood, and journal notes.</description>
    <enableActivities>true</enableActivities>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <label>Daily Health Record</label>
    <nameField>
        <label>Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
        <displayFormat>DHR-{00000}</displayFormat>
    </nameField>
    <pluralLabel>Daily Health Records</pluralLabel>
    <searchLayouts>
        <lookupDialogsAdditionalFields>Contact__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Activity_Date__c</lookupDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>Contact__c</lookupPhoneDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>Activity_Date__c</lookupPhoneDialogsAdditionalFields>
        <searchResultsAdditionalFields>Contact__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Activity_Date__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Weight_KG__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Mood__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
